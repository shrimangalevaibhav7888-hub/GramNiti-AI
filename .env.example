# ==========================================
# GramNiti AI - Environment Configuration
# ==========================================

# Backend Database Connection
# Default SQLite (local development):
DATABASE_URL=sqlite:///./gramniti.db

# Production PostgreSQL (Supabase / Neon / Render Postgres / AWS RDS):
# DATABASE_URL=postgresql://postgres:your_password@db.example.supabase.co:5432/postgres

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Frontend API Configuration (Vite)
# For local development with Vite dev server proxy:
VITE_API_URL=

# For production deployment (e.g. Vercel frontend calling hosted backend):
# VITE_API_URL=https://your-gramniti-backend.onrender.com
